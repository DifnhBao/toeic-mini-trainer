DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
GEMINI_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Native Android/iOS auth. Generate an independent secret with at least 32
# random characters; never reuse NEXTAUTH_SECRET.
MOBILE_JWT_SECRET=""
# Random server-only value (32+ chars). The same value must be configured as
# INGESTION_WORKER_SECRET in Vercel and GitHub Actions; never expose in mobile.
INGESTION_WORKER_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
# Web OAuth client used as the audience of native Google ID tokens.
# If omitted, the backend falls back to GOOGLE_CLIENT_ID.
GOOGLE_MOBILE_WEB_CLIENT_ID=""
APPLE_CLIENT_ID=""

# Private S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...).
# These values are server-only. Never prefix them with NEXT_PUBLIC_.
OBJECT_STORAGE_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET="toeic-mini-trainer-private"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="false"
